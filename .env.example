# Copying this to .env is optional; setup_key.py creates .env for you.
# Keep your real key out of this repository and out of browser JavaScript.
TOPDECK_API_KEY=replace-with-your-key

# Optional Moxfield community-list source. Moxfield's read API is unofficial;
# use either a current browser-session bearer token or a Moxfield-issued
# read-only User-Agent. Both values stay on the local server.
MOXFIELD_AUTH_TOKEN=replace-with-your-token
MOXFIELD_USER_AGENT=
MOXFIELD_MIN_VIEWS=50
MOXFIELD_MIN_LIKES=2
