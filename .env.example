# Copying this to .env is optional; setup_key.py creates .env for you.
# Keep your real key out of this repository and out of browser JavaScript.
TOPDECK_API_KEY=replace-with-your-key

# Optional Moxfield community-list source. Use a read-only User-Agent issued
# by Moxfield; do not use a personal browser-session credential.
MOXFIELD_USER_AGENT=
MOXFIELD_MIN_VIEWS=50
MOXFIELD_MIN_LIKES=2

# Optional fallback for Card Lab deckbuilding review. Prefer the local
# "Continue with ChatGPT" connection in Card Lab; that stores its OAuth
# credentials locally and does not place tokens in browser JavaScript.
# Keep a real API key only in .env if you explicitly want API billing fallback.
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-5.6-terra
